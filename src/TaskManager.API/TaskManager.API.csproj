    <UserSecretsId>e2de29fe-c365-48c4-a77c-782fd4087840</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
